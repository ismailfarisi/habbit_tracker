<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: Google auto-backup of the app's preferences (settings, logs, tasks, habits).
     flutter_secure_storage files are excluded: their keys live in the device keystore and cannot be
     decrypted on another device, so the API key has to be entered again after a restore. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
</full-backup-content>
